// Windows Resource Script for NavStudio
#include <windows.h>

// Application executable icon (ID 1 is used by Windows Explorer)
1 ICON "nav_editor.ico"

// Executable version metadata
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,6,2,0
PRODUCTVERSION  1,6,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments",         "NavStudio - Hardware-accelerated 3D BSP & NavMesh Editor"
            VALUE "CompanyName",      "ZeroDiamond7601"
            VALUE "FileDescription",  "NavStudio 3D Editor"
            VALUE "FileVersion",      "1.6.2.0"
            VALUE "InternalName",     "nav_editor"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ZeroDiamond7601"
            VALUE "OriginalFilename", "nav_editor.exe"
            VALUE "ProductName",      "NavStudio"
            VALUE "ProductVersion",   "1.6.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
